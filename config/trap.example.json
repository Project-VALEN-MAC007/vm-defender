{
  "project_root": "..",
  "dashboard": {
    "host": "127.0.0.1",
    "port": 9090,
    "maximum_rows": 5000
  },
  "security": {
    "users_file": "/var/lib/trap/dashboard-users/users.json",
    "audit_log": "/var/log/trap/dashboard-security.jsonl",
    "session_ttl_seconds": 3600,
    "secure_cookie": false,
    "login_max_attempts": 5,
    "login_window_seconds": 300
  },
  "paths": {
    "decisions": "/var/log/adaptive-defender/decisions.jsonl",
    "status": "/var/lib/trap/status.json",
    "eve_paths": [
      "/var/log/suricata/eve.json"
    ],
    "rabbit_hole_config": "/var/lib/trap/rabbit-hole.json",
    "rabbit_hole_logs": [
      "/var/log/trap/honeypot/rabbit-hole-web.jsonl"
    ],
    "honeypot_paths": [
      "/var/log/trap/honeypot/cowrie.json",
      "/var/log/trap/honeypot/tanner-events.jsonl"
    ]
  },
  "network": {
    "management_interface": "CHANGE_ME",
    "outer_interface": "CHANGE_ME",
    "outer_ip": "192.168.56.10",
    "inner_interface": "CHANGE_ME",
    "inner_ip": "10.10.10.1"
  },
  "rules": {
    "active_rules": "/etc/suricata/rules/et-open-selected.rules",
    "baseline": "tests/fixtures/baseline.json",
    "registry": "/var/lib/trap/rules/registry.jsonl",
    "backup_dir": "/var/lib/trap/backups/rules",
    "apply_dir": "/var/lib/trap/rules",
    "suricata_config": "/etc/suricata/suricata.yaml",
    "allow_deploy": false
  }
}
