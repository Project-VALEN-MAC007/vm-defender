# Render only after person 2 confirms every __TOKEN__ value.
map $remote_addr $adaptive_profile {
    include __REDIRECT_MAP_PATH__;
}

map $adaptive_profile $adaptive_backend {
    default     http://127.0.0.1:8080;
    real        http://127.0.0.1:8080;
    wordpress   http://__WORDPRESS_IP__:__WORDPRESS_PORT__;
    phpmyadmin  http://__PHPMYADMIN_IP__:__PHPMYADMIN_PORT__;
}

log_format adaptive_json escape=json '{"timestamp":"$time_iso8601",'
  '"source_ip":"$remote_addr","forwarded_for":"$proxy_add_x_forwarded_for",'
  '"protocol":"$scheme","profile":"$adaptive_profile","status":$status,'
  '"request":"$request","upstream":"$upstream_addr"}';

server {
    listen __OUTER_IP__:80;
    server_name defender.lab;
    access_log /var/log/nginx/adaptive_access.json adaptive_json;

    return 308 https://$host$request_uri;
}

server {
    listen __OUTER_IP__:443 ssl;
    server_name defender.lab;
    ssl_certificate __LAB_CERT_PATH__;
    ssl_certificate_key __LAB_KEY_PATH__;
    access_log /var/log/nginx/adaptive_access.json adaptive_json;

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @backend_unavailable_tls;
        proxy_pass $adaptive_backend;
    }

    location @backend_unavailable_tls {
        default_type application/json;
        add_header Cache-Control no-store always;
        return 503 '{"status":"backend_unavailable","profile":"$adaptive_profile"}';
    }
}
