# MIMIC-owned SIDs: 2200001-2200999. Never reuse retired SIDs.
# HOME_NET must contain only protected Defender destination addresses.
# Sources may be private lab addresses, so these rules use any -> $HOME_NET.
# Rules are alert-only. Site-specific WordPress/phpMyAdmin rules 2200001,
# 2200002 and 2200006, TLS lab SNI 2200101, and SSH banner 2200201 are retired.

# Web reconnaissance and access attempts independent of the web application.
alert http any any -> $HOME_NET any (msg:"scanner_user_agent"; flow:established,to_server; http.user_agent; pcre:"/(?:sqlmap|nikto|nuclei)/i"; classtype:attempted-recon; metadata:severity medium, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200003; rev:4;)
alert http any any -> $HOME_NET any (msg:"env_file_access"; flow:established,to_server; http.uri; content:"/.env"; startswith; nocase; classtype:web-application-attack; metadata:severity high, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200004; rev:3;)
alert http any any -> $HOME_NET any (msg:"git_config_access"; flow:established,to_server; http.uri; content:"/.git/config"; startswith; nocase; classtype:web-application-attack; metadata:severity high, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200005; rev:3;)
alert http any any -> $HOME_NET any (msg:"path_traversal"; flow:established,to_server; http.uri.raw; content:"../"; content:"etc/passwd"; distance:0; within:64; classtype:web-application-attack; metadata:severity high, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200007; rev:2;)
alert http any any -> $HOME_NET any (msg:"password_file_access"; flow:established,to_server; http.uri; content:"/.htpasswd"; startswith; nocase; classtype:web-application-attack; metadata:severity high, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200008; rev:2;)
alert http any any -> $HOME_NET any (msg:"svn_metadata_access"; flow:established,to_server; http.uri; content:"/.svn/entries"; startswith; nocase; classtype:attempted-recon; metadata:severity medium, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200009; rev:2;)

# HTTPS transport policy: tls.version is the negotiated version, not a URI or
# the legacy record version offered in ClientHello. Nginx should reject both.
alert tls any any -> $HOME_NET 443 (msg:"tls_1_0_negotiated"; flow:established,to_server; tls.version:1.0; classtype:misc-activity; metadata:severity low, project mimic, protocol https; threshold:type limit, track by_src, count 1, seconds 300; sid:2200102; rev:1;)
alert tls any any -> $HOME_NET 443 (msg:"tls_1_1_negotiated"; flow:established,to_server; tls.version:1.1; classtype:misc-activity; metadata:severity low, project mimic, protocol https; threshold:type limit, track by_src, count 1, seconds 300; sid:2200103; rev:1;)

# Repeated SYNs are indicators, not proof of distinct connections or ports.
alert tcp any any -> $HOME_NET 22 (msg:"ssh_connection_burst"; flow:to_server,stateless; flags:S; classtype:attempted-admin; metadata:severity high, project mimic, protocol ssh; threshold:type both, track by_src, count 5, seconds 30; sid:2200202; rev:4;)
alert tcp any any -> $HOME_NET 23 (msg:"telnet_connection_burst"; flow:to_server,stateless; flags:S; classtype:attempted-admin; metadata:severity high, project mimic, protocol telnet; threshold:type both, track by_src, count 5, seconds 30; sid:2200203; rev:4;)
alert tcp any any -> $HOME_NET any (msg:"syn_burst"; flow:to_server,stateless; flags:S; classtype:network-scan; metadata:severity medium, project mimic, protocol scan, behavior raise_next_connection_risk; threshold:type both, track by_src, count 10, seconds 5; sid:2200301; rev:4;)
