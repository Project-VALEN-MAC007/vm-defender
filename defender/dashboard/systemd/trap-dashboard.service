[Unit]
Description=TRAP Defender Dashboard
After=network-online.target suricata.service adaptive-defender.service
Wants=network-online.target

[Service]
Type=simple
User=trap-dashboard
Group=trap-dashboard
SupplementaryGroups=suricata
WorkingDirectory=/opt/trap
ExecStart=/usr/bin/python3 /opt/trap/run_dashboard.py --config /etc/trap/trap.json
Restart=on-failure
RestartSec=3s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/opt/trap /etc/trap /var/log/suricata /var/log/adaptive-defender
ReadWritePaths=/var/log/trap /var/lib/trap

[Install]
WantedBy=multi-user.target
