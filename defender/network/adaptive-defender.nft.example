#!/usr/sbin/nft -f

# TEMPLATE ONLY. Replace the marked values only after observing real lab NICs.
table inet adaptive_defender {
    set ssh_redirect {
        type ipv4_addr
        flags timeout
        timeout 30m
    }

    set telnet_redirect {
        type ipv4_addr
        flags timeout
        timeout 30m
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        # No broad outer-to-inner accept rule belongs here.
    }
}
