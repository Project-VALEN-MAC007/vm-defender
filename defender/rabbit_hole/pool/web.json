{
  "version": 1,
  "protocol": "web",
  "note": "Decoy pool for the Jev-driven Rabbit Hole. Items have no fixed order: every {{clue:<slot>}} is filled per session with an item Jev (or the fallback) picks from the slot's candidates.",
  "items": [
    {"id": "robots", "kind": "file", "category": "recon", "entry": true, "lure": 1,
     "path": "/robots.txt",
     "description": "robots.txt that lists hidden paths as Disallow lines",
     "body_lines": ["User-agent: *", "Disallow: {{clue:first}}", "Disallow: {{clue:second}}", "Disallow: /cgi-bin/"],
     "slots": {"first": {"categories": ["backup", "api", "admin"]},
               "second": {"categories": ["backup", "api", "notes"]}}},

    {"id": "env", "kind": "file", "category": "config", "entry": true, "lure": 3,
     "path": "/.env",
     "description": "Laravel .env with database password and an admin path hint",
     "body_lines": [
       "APP_NAME=\"{{org.name}}\"",
       "APP_ENV=production",
       "APP_URL=https://{{org.domain}}",
       "APP_KEY=base64:{{secret:hex:44:appkey}}",
       "DB_CONNECTION=mysql",
       "DB_HOST={{ip:db}}",
       "DB_DATABASE={{org.db_name}}",
       "DB_USERNAME=portal_rw",
       "DB_PASSWORD={{secret:password:db}}",
       "MAIL_HOST=mail.{{org.domain}}",
       "ADMIN_PATH={{clue:admin}}",
       "BACKUP_URL={{clue:store}}"],
     "slots": {"admin": {"categories": ["admin"], "kinds": ["form"]},
               "store": {"categories": ["backup", "api"]}}},

    {"id": "git-config", "kind": "file", "category": "recon", "entry": true, "lure": 2,
     "path": "/.git/config",
     "description": "Exposed .git/config with a deploy notes comment",
     "body_lines": [
       "[core]", "\trepositoryformatversion = 0", "\tbare = false",
       "[remote \"origin\"]",
       "\turl = git@git.{{org.domain}}:{{org.short_name}}/portal.git",
       "\tfetch = +refs/heads/*:refs/remotes/origin/*",
       "[branch \"main\"]", "\tremote = origin",
       "# deploy notes: {{clue:notes}}"],
     "slots": {"notes": {"categories": ["notes"]}}},

    {"id": "deploy-notes", "kind": "file", "category": "notes", "lure": 2,
     "path": "/deploy/NOTES.txt",
     "description": "Deploy checklist naming the moved admin panel and the latest backup",
     "body_lines": [
       "Deploy checklist ({{date:-3}})",
       "1. git pull on {{org.hostname}}",
       "2. php artisan migrate --force",
       "3. Admin panel moved to {{clue:admin}} (old /admin is disabled)",
       "4. Ask {{org.admin_user}} for the panel password",
       "5. Latest backup before deploy: {{clue:backup}}"],
     "slots": {"admin": {"categories": ["admin"], "kinds": ["form"]},
               "backup": {"categories": ["backup", "config"]}}},

    {"id": "backup-index", "kind": "listing", "category": "backup", "entry": true, "lure": 2,
     "path": "/backup/", "title": "Index of /backup/",
     "description": "Open directory listing of nightly backups",
     "filler": ["db_{{date:-1}}.sql.gz", "site-{{date:-7}}.tar.gz"],
     "slots": {"items": {"categories": ["config", "notes", "backup", "credential", "data"], "under": true, "count": 2}}},

    {"id": "backup-config", "kind": "api", "category": "config", "lure": 3,
     "path": "/backup/config.json",
     "description": "Application config backup with DB password and an internal API key and URL",
     "body_lines": [
       "{",
       "  \"app\": \"{{org.short_name}}-portal\",",
       "  \"environment\": \"production\",",
       "  \"database\": {\"host\": \"{{ip:db}}\", \"name\": \"{{org.db_name}}\", \"user\": \"portal_rw\", \"password\": \"{{secret:password:db}}\"},",
       "  \"api\": {\"base_url\": \"https://{{org.domain}}{{clue:api}}\", \"key\": \"{{secret:token:api}}\"},",
       "  \"backup\": {\"owner\": \"{{org.admin_user}}\", \"schedule\": \"0 2 * * *\"}",
       "}"],
     "slots": {"api": {"categories": ["api"]}}},

    {"id": "wp-config-bak", "kind": "file", "category": "config", "lure": 3,
     "path": "/backup/wp-config.php.bak",
     "description": "WordPress config backup with database credentials and an admin URL note",
     "body_lines": [
       "<?php",
       "define('DB_NAME', '{{org.db_name}}');",
       "define('DB_USER', 'wp_{{org.short_name}}');",
       "define('DB_PASSWORD', '{{secret:password:wpdb}}');",
       "define('DB_HOST', '{{ip:db}}');",
       "define('AUTH_KEY', '{{secret:hex:48:wpauth}}');",
       "// staff login moved to {{clue:admin}}",
       "$table_prefix = 'wp_';"],
     "slots": {"admin": {"categories": ["admin"], "kinds": ["form"]}}},

    {"id": "backup-readme", "kind": "file", "category": "notes", "lure": 1,
     "path": "/backup/README.txt",
     "description": "Backup README that mentions where old exports were moved",
     "body_lines": [
       "{{org.name}} - nightly backup",
       "Maintainer: {{org.admin_user}}@{{org.domain}}",
       "",
       "Daily dumps are rotated after 7 days.",
       "Old user exports were moved to {{clue:old}} for the audit ({{date:-30}}).",
       "TODO: delete after the audit is closed."],
     "slots": {"old": {"categories": ["backup", "data"]}}},

    {"id": "htpasswd-bak", "kind": "file", "category": "credential", "lure": 3,
     "path": "/backup/.htpasswd.bak",
     "description": "Backup of an .htpasswd file with an admin password hash",
     "body_lines": [
       "{{org.admin_user}}:$apr1${{secret:hex:8:htsalt}}${{secret:hex:22:hthash}}",
       "deploy:$apr1${{secret:hex:8:htsalt2}}${{secret:hex:22:hthash2}}"]},

    {"id": "old-exports", "kind": "listing", "category": "backup", "lure": 2,
     "path": "/backup/old/", "title": "Index of /backup/old/",
     "description": "Folder of old exports kept for an audit",
     "filler": ["orders_{{date:-60}}.csv"],
     "slots": {"items": {"categories": ["data"], "under": true, "count": 1}}},

    {"id": "users-export", "kind": "file", "category": "data", "lure": 3,
     "path": "/backup/old/users_export_{{date:-30}}.csv",
     "description": "CSV export of user accounts (names, emails, roles)",
     "content_type": "text/csv; charset=utf-8", "body": "{{people_csv:25}}\n"},

    {"id": "db-folder", "kind": "listing", "category": "backup", "lure": 2,
     "path": "/backup/db/", "title": "Index of /backup/db/",
     "description": "Folder of database dumps",
     "filler": ["{{org.db_name}}_{{date:-8}}.sql.gz"],
     "slots": {"items": {"categories": ["data"], "under": true, "count": 1}}},

    {"id": "db-dump", "kind": "file", "category": "data", "lure": 3,
     "path": "/backup/db/{{org.db_name}}_{{date:-1}}.sql",
     "description": "SQL dump of the users table with password hashes",
     "content_type": "text/plain; charset=utf-8",
     "body_lines": [
       "-- MySQL dump 10.13  Distrib 8.0.36, for Linux (x86_64)",
       "-- Host: {{ip:db}}    Database: {{org.db_name}}",
       "CREATE TABLE `users` (`id` int NOT NULL, `email` varchar(120), `password` varchar(64), `role` varchar(20));",
       "INSERT INTO `users` VALUES (1,'{{person:1:email}}','$2y$10${{secret:hex:53:pw1}}','admin'),",
       "(2,'{{person:2:email}}','$2y$10${{secret:hex:53:pw2}}','staff'),",
       "(3,'{{person:3:email}}','$2y$10${{secret:hex:53:pw3}}','staff');"]},

    {"id": "api-docs", "kind": "file", "category": "api", "lure": 2,
     "path": "/api/docs",
     "description": "Internal API documentation naming the base URL and the auth header",
     "body_lines": [
       "{{org.name}} internal API v1",
       "Base URL: {{clue:base}}",
       "Authentication: send header X-API-Key (see deployment config).",
       "",
       "GET {{clue:endpoint}}      list records"],
     "slots": {"base": {"categories": ["api"], "kinds": ["api"]},
               "endpoint": {"categories": ["data"], "kinds": ["api", "people_api"]}}},

    {"id": "api-index", "kind": "api", "category": "api", "lure": 2,
     "path": "/api/v1/",
     "description": "API index that lists data endpoints",
     "body_lines": [
       "{\"service\": \"{{org.short_name}}-api\", \"version\": \"1.4.2\", \"auth\": \"X-API-Key\",",
       " \"endpoints\": [\"{{clue:first}}\", \"{{clue:second}}\"]}"],
     "slots": {"first": {"categories": ["data"], "kinds": ["api", "people_api"]},
               "second": {"categories": ["data"], "kinds": ["api", "people_api"]}}},

    {"id": "api-users", "kind": "people_api", "category": "data", "lure": 3,
     "path": "/api/v1/users",
     "description": "API that returns staff accounts (needs the API key)",
     "requires_header": {"X-API-Key": "{{secret:token:api}}"}, "body": "12"},

    {"id": "api-invoices", "kind": "api", "category": "data", "lure": 3,
     "path": "/api/v1/invoices",
     "description": "API that returns open invoices with customer names and amounts (needs the API key)",
     "requires_header": {"X-API-Key": "{{secret:token:api}}"},
     "body_lines": [
       "{\"items\": [",
       " {\"invoice\": \"INV-{{secret:int:20000:29999:inv1}}\", \"customer\": \"{{person:2:name}}\", \"amount\": {{secret:int:12000:98000:amt1}}, \"due\": \"{{date:7}}\"},",
       " {\"invoice\": \"INV-{{secret:int:30000:39999:inv2}}\", \"customer\": \"{{person:5:name}}\", \"amount\": {{secret:int:5000:45000:amt2}}, \"due\": \"{{date:14}}\"}",
       "], \"total\": 2}"]},

    {"id": "admin-login", "kind": "form", "category": "admin", "lure": 2,
     "path": "/internal/admin-{{secret:hex:6:adminpath}}/", "title": "{{org.name}} Admin",
     "description": "Hidden administrator sign-in page (any login is accepted)",
     "body_lines": [
       "<!doctype html><html><head><title>{{org.name}} - Admin</title></head>",
       "<body style=\"font-family:sans-serif;max-width:360px;margin:80px auto\">",
       "<h2>{{org.name}}</h2><p>Administrator sign in</p>",
       "<form method=\"post\"><p><input name=\"username\" placeholder=\"Username\"></p>",
       "<p><input name=\"password\" type=\"password\" placeholder=\"Password\"></p>",
       "<p><button>Sign in</button></p></form></body></html>"],
     "slots": {"after": {"categories": ["admin"], "kinds": ["file"]}}},

    {"id": "admin-home", "kind": "file", "category": "admin", "lure": 2,
     "path": "/internal/admin-{{secret:hex:6:adminpath}}/home",
     "description": "Admin dashboard page with a link to data exports",
     "content_type": "text/html; charset=utf-8",
     "body_lines": [
       "<!doctype html><html><head><title>Dashboard</title></head><body style=\"font-family:sans-serif\">",
       "<h2>{{org.name}} admin</h2><p>Welcome back, {{org.admin_user}}. Last login {{date:-1}} from {{ip:vpn}}.</p>",
       "<ul><li><a href=\"{{clue:exports}}\">Data exports</a></li><li>Users (maintenance)</li><li>Settings (maintenance)</li></ul>",
       "</body></html>"],
     "slots": {"exports": {"categories": ["backup"], "kinds": ["listing"]}}},

    {"id": "admin-exports", "kind": "listing", "category": "backup", "lure": 2,
     "path": "/internal/admin-{{secret:hex:6:adminpath}}/exports/", "title": "Exports",
     "description": "Admin export folder",
     "filler": ["payments_{{date:-14}}.xlsx"],
     "slots": {"items": {"categories": ["data"], "under": true, "count": 1}}},

    {"id": "customers-export", "kind": "file", "category": "data", "lure": 3,
     "path": "/internal/admin-{{secret:hex:6:adminpath}}/exports/customers_{{date:-2}}.csv",
     "description": "CSV export of customers",
     "content_type": "text/csv; charset=utf-8", "body": "{{people_csv:40}}\n"}
  ]
}
