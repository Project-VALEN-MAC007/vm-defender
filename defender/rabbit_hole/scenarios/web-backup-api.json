{
  "id": "web-backup-api",
  "title": "ไฟล์สำรองและ API ภายใน",
  "description": "ผู้โจมตีพบโฟลเดอร์ไฟล์สำรองจาก robots.txt แล้วเจอไฟล์ตั้งค่าที่มี API Key ซึ่งนำไปเรียก API ข้อมูลผู้ใช้และใบแจ้งหนี้ได้",
  "protocol": "web",
  "entry": ["robots", "backup-index"],
  "nodes": [
    {"id": "robots", "kind": "file", "path": "/robots.txt",
     "body_lines": ["User-agent: *", "Disallow: {{node:backup-index}}", "Disallow: {{node:api-docs}}", "Disallow: /cgi-bin/"],
     "next": ["backup-index", "api-docs"]},
    {"id": "backup-index", "kind": "listing", "path": "/backup/", "title": "Index of /backup/",
     "next": ["backup-config", "backup-readme"],
     "filler": ["db_{{date:-1}}.sql.gz", "site-{{date:-7}}.tar.gz"]},
    {"id": "backup-config", "kind": "api", "path": "/backup/config.json",
     "body_lines": [
       "{",
       "  \"app\": \"{{org.short_name}}-portal\",",
       "  \"environment\": \"production\",",
       "  \"database\": {\"host\": \"{{ip:db}}\", \"name\": \"{{org.db_name}}\", \"user\": \"portal_rw\", \"password\": \"{{secret:password:db}}\"},",
       "  \"api\": {\"base_url\": \"https://{{org.domain}}{{node:api-index}}\", \"key\": \"{{secret:token:api}}\"},",
       "  \"backup\": {\"owner\": \"{{org.admin_user}}\", \"schedule\": \"0 2 * * *\"}",
       "}"],
     "next": ["api-index"]},
    {"id": "backup-readme", "kind": "file", "path": "/backup/README.txt",
     "body_lines": [
       "{{org.name}} - nightly backup",
       "Maintainer: {{org.admin_user}}@{{org.domain}}",
       "",
       "Daily dumps are rotated after 7 days.",
       "Old user exports were moved to {{node:old-exports}} for the audit ({{date:-30}}).",
       "TODO: delete after the audit is closed."],
     "next": ["old-exports"]},
    {"id": "old-exports", "kind": "listing", "path": "/backup/old/", "title": "Index of /backup/old/",
     "next": ["users-export"], "filler": ["orders_{{date:-60}}.csv"]},
    {"id": "users-export", "kind": "file", "path": "/backup/old/users_export_{{date:-30}}.csv",
     "content_type": "text/csv; charset=utf-8", "body": "{{people_csv:25}}\n"},
    {"id": "api-docs", "kind": "file", "path": "/api/docs",
     "body_lines": [
       "{{org.name}} internal API v1",
       "Base URL: {{node:api-index}}",
       "Authentication: send header X-API-Key (see deployment config).",
       "",
       "GET {{node:api-users}}      list accounts",
       "GET {{node:api-users}}/<id> account detail",
       "GET {{node:api-invoices}}   open invoices"],
     "next": ["api-index"]},
    {"id": "api-index", "kind": "api", "path": "/api/v1/",
     "body_lines": [
       "{\"service\": \"{{org.short_name}}-api\", \"version\": \"1.4.2\", \"auth\": \"X-API-Key\",",
       " \"endpoints\": [\"{{node:api-users}}\", \"{{node:api-invoices}}\"]}"],
     "next": ["api-users", "api-invoices"]},
    {"id": "api-users", "kind": "people_api", "path": "/api/v1/users",
     "requires_header": {"X-API-Key": "{{secret:token:api}}"}, "body": "12"},
    {"id": "api-invoices", "kind": "api", "path": "/api/v1/invoices",
     "requires_header": {"X-API-Key": "{{secret:token:api}}"},
     "body_lines": [
       "{\"items\": [",
       " {\"invoice\": \"INV-{{secret:int:20000:29999:inv1}}\", \"customer\": \"{{person:2:name}}\", \"amount\": {{secret:int:12000:98000:amt1}}, \"due\": \"{{date:7}}\"},",
       " {\"invoice\": \"INV-{{secret:int:30000:39999:inv2}}\", \"customer\": \"{{person:5:name}}\", \"amount\": {{secret:int:5000:45000:amt2}}, \"due\": \"{{date:14}}\"},",
       " {\"invoice\": \"INV-{{secret:int:40000:49999:inv3}}\", \"customer\": \"{{person:9:name}}\", \"amount\": {{secret:int:30000:150000:amt3}}, \"due\": \"{{date:21}}\"}",
       "], \"total\": 3}"]}
  ]
}
