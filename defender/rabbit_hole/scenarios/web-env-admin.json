{
  "id": "web-env-admin",
  "title": "ไฟล์ .env และหน้าแอดมินที่ซ่อนไว้",
  "description": "ผู้โจมตีอ่าน .env หรือ .git/config แล้วพบที่อยู่หน้าแอดมินที่ซ่อนไว้ เมื่อเข้าสู่ระบบจะเห็นไฟล์ Export ข้อมูลลูกค้า",
  "protocol": "web",
  "entry": ["env", "git-config"],
  "nodes": [
    {"id": "env", "kind": "file", "path": "/.env",
     "body_lines": [
       "APP_NAME=\"{{org.name}}\"",
       "APP_ENV=production",
       "APP_URL=https://{{org.domain}}",
       "APP_KEY=base64:{{secret:hex:44:appkey}}",
       "DB_CONNECTION=mysql",
       "DB_HOST={{ip:db}}",
       "DB_DATABASE={{org.db_name}}",
       "DB_USERNAME=portal_rw",
       "DB_PASSWORD={{secret:password:db}}",
       "MAIL_HOST=mail.{{org.domain}}",
       "ADMIN_PATH={{node:admin-login}}",
       "ADMIN_DEFAULT_USER={{org.admin_user}}"],
     "next": ["admin-login"]},
    {"id": "git-config", "kind": "file", "path": "/.git/config",
     "body_lines": [
       "[core]",
       "\trepositoryformatversion = 0",
       "\tbare = false",
       "[remote \"origin\"]",
       "\turl = git@git.{{org.domain}}:{{org.short_name}}/portal.git",
       "\tfetch = +refs/heads/*:refs/remotes/origin/*",
       "[branch \"main\"]",
       "\tremote = origin",
       "# deploy notes: {{node:deploy-notes}}"],
     "next": ["deploy-notes"]},
    {"id": "deploy-notes", "kind": "file", "path": "/deploy/NOTES.txt",
     "body_lines": [
       "Deploy checklist ({{date:-3}})",
       "1. git pull on {{org.hostname}}",
       "2. php artisan migrate --force",
       "3. Admin panel moved to {{node:admin-login}} (old /admin is disabled)",
       "4. Ask {{org.admin_user}} for the panel password"],
     "next": ["admin-login"]},
    {"id": "admin-login", "kind": "form", "path": "/internal/admin-{{secret:hex:6:adminpath}}/",
     "title": "{{org.name}} Admin",
     "body_lines": [
       "<!doctype html><html><head><title>{{org.name}} - Admin</title></head>",
       "<body style=\"font-family:sans-serif;max-width:360px;margin:80px auto\">",
       "<h2>{{org.name}}</h2><p>Administrator sign in</p>",
       "<form method=\"post\"><p><input name=\"username\" placeholder=\"Username\"></p>",
       "<p><input name=\"password\" type=\"password\" placeholder=\"Password\"></p>",
       "<p><button>Sign in</button></p></form></body></html>"],
     "next": ["admin-home"]},
    {"id": "admin-home", "kind": "file", "path": "/internal/admin-{{secret:hex:6:adminpath}}/home",
     "content_type": "text/html; charset=utf-8",
     "body_lines": [
       "<!doctype html><html><head><title>Dashboard</title></head><body style=\"font-family:sans-serif\">",
       "<h2>{{org.name}} admin</h2><p>Welcome back, {{org.admin_user}}. Last login {{date:-1}} from {{ip:vpn}}.</p>",
       "<ul><li><a href=\"{{node:admin-exports}}\">Data exports</a></li><li>Users (maintenance)</li><li>Settings (maintenance)</li></ul>",
       "</body></html>"],
     "next": ["admin-exports"]},
    {"id": "admin-exports", "kind": "listing", "path": "/internal/admin-{{secret:hex:6:adminpath}}/exports/",
     "title": "Exports", "next": ["customers-export"], "filler": ["payments_{{date:-14}}.xlsx"]},
    {"id": "customers-export", "kind": "file",
     "path": "/internal/admin-{{secret:hex:6:adminpath}}/exports/customers_{{date:-2}}.csv",
     "content_type": "text/csv; charset=utf-8", "body": "{{people_csv:40}}\n"}
  ]
}
