[Unit]
Description=TRAP deploy agent (receive SNARE pages from the Defender and deploy)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=trapdeploy
Group=trapdeploy
SupplementaryGroups=docker
WorkingDirectory=/opt/trap
ExecStart=/usr/bin/python3 /opt/trap/run_deploy_agent.py --config /etc/trap/deploy-agent.json
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
