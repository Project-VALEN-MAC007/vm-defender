# TRAP Web Honeypot (Rabbit Hole web decoy). Standard library only.
FROM python:3.12-slim
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin traprabbit
WORKDIR /opt/trap
COPY defender/__init__.py defender/__init__.py
COPY defender/rabbit_hole defender/rabbit_hole
COPY run_rabbit_hole.py run_rabbit_hole.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001
EXPOSE 8084
ENTRYPOINT ["python3", "/opt/trap/run_rabbit_hole.py"]
CMD ["--config", "/var/lib/trap/rabbit-hole.json"]
