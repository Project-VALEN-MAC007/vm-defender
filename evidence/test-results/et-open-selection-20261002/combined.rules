# Selected ET Open rules for MIMIC. Upstream rule text, SID and rev preserved.
# Retrieved 2026-10-02; Suricata 7.0.3 ruleset.
# Source: https://rules.emergingthreats.net/open/suricata-7.0.3/emerging.rules.tar.gz
# See ../et-open-selection.md and ../licenses/ for provenance and licenses.
# Telnet response rules are telemetry-only with the current Decision Engine.

# Upstream file: rules/emerging-scan.rules
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"ET SCAN Potential SSH Scan"; flow:to_server; flags:S,12; threshold: type both, track by_src, count 5, seconds 120; reference:url,en.wikipedia.org/wiki/Brute_force_attack; classtype:attempted-recon; sid:2001219; rev:20; metadata:created_at 2010_07_30, confidence Medium, signature_severity Informational, updated_at 2019_07_26;)

# Upstream file: rules/emerging-scan.rules
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET SCAN Nikto Web App Scan in Progress"; flow:established,to_server; threshold: type both, count 5, seconds 60, track by_src; http.user_agent; content:"(Nikto"; reference:url,www.cirt.net/code/nikto.shtml; classtype:web-application-attack; sid:2002677; rev:15; metadata:created_at 2010_07_30, confidence Medium, signature_severity Informational, updated_at 2024_03_06;)

# Upstream file: rules/emerging-web_server.rules
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SERVER Possible SQL Injection Attempt UNION SELECT in HTTP URI"; flow:established,to_server; http.uri; content:"UNION"; fast_pattern; nocase; content:"SELECT"; nocase; within:100; pcre:"/UNION.+SELECT.+(?:\x3b|\x253b)/i"; reference:url,en.wikipedia.org/wiki/SQL_injection; classtype:web-application-attack; sid:2006446; rev:18; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, confidence Medium, signature_severity Major, tag SQL_Injection, updated_at 2024_11_28, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)

# Upstream file: rules/emerging-scan.rules
alert ssh $EXTERNAL_NET any -> $HOME_NET 22 (msg:"ET SCAN LibSSH Based Frequent SSH Connections Likely BruteForce Attack"; flow:established,to_server; content:"SSH-"; content:"libssh"; within:20; threshold: type both, count 5, seconds 30, track by_src; classtype:attempted-admin; sid:2006546; rev:9; metadata:created_at 2010_07_30, confidence Medium, signature_severity Informational, updated_at 2019_07_26;)

# Upstream file: rules/emerging-scan.rules
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET SCAN Sqlmap SQL Injection Scan"; flow:established,to_server; threshold: type limit, count 2, seconds 40, track by_src; http.user_agent; content:"sqlmap"; startswith; reference:url,sqlmap.sourceforge.net; classtype:attempted-recon; sid:2008538; rev:10; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, confidence Medium, signature_severity Major, tag SQL_Injection, updated_at 2024_04_13, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)

# Upstream file: rules/emerging-scan.rules
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET SCAN Nmap Scripting Engine User-Agent Detected (Nmap NSE)"; flow:established,to_server; http.user_agent; content:"Nmap NSE"; classtype:web-application-attack; sid:2009359; rev:6; metadata:created_at 2010_07_30, confidence High, signature_severity Informational, updated_at 2024_03_06;)

# Upstream file: rules/emerging-web_server.rules
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SERVER /etc/passwd Detected in URI"; flow:established,to_server; http.uri; content:"/etc/passwd"; nocase; classtype:attempted-recon; sid:2049400; rev:1; metadata:affected_product Linux, attack_target Web_Server, created_at 2023_11_29, deployment Perimeter, deployment SSLDecrypt, performance_impact Low, confidence High, signature_severity Informational, updated_at 2023_11_29;)

# Upstream file: rules/emerging-web_server.rules
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SERVER Possible SQL Injection UNION SELECT in HTTP Request Body"; flow:established,to_server; http.request_body; content:"UNION"; fast_pattern; nocase; content:"SELECT"; nocase; distance:0; reference:url,owasp.org/www-community/attacks/SQL_Injection; classtype:attempted-admin; sid:2053468; rev:1; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2024_06_11, deployment Perimeter, deployment SSLDecrypt, performance_impact Moderate, confidence Medium, signature_severity Major, tag SQL_Injection, updated_at 2024_06_11, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)

# Upstream file: rules/emerging-telnet.rules
alert tcp $TELNET_SERVERS 23 -> $EXTERNAL_NET any (msg:"GPL TELNET TELNET login failed"; flow:established,to_client; content:"Login failed"; nocase; classtype:bad-unknown; sid:2100492; rev:11; metadata:created_at 2010_09_23, signature_severity Unknown, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2024_03_08;)

# Upstream file: rules/emerging-web_server.rules
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"GPL WEB_SERVER .htpasswd access"; flow:established,to_server; http.uri; content:".htpasswd"; nocase; classtype:web-application-attack; sid:2101071; rev:10; metadata:created_at 2010_09_23, signature_severity Unknown, updated_at 2024_05_21;)

# Upstream file: rules/emerging-telnet.rules
alert tcp $HOME_NET 23 -> $EXTERNAL_NET any (msg:"GPL TELNET Bad Login"; flow:established,to_client; content:"Login incorrect"; nocase; fast_pattern; classtype:bad-unknown; sid:2101251; rev:11; metadata:created_at 2010_09_23, signature_severity Unknown, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2024_03_08;)


# MIMIC-owned SIDs: 2200001-2200999. Never reuse retired SIDs.
# HOME_NET must contain only protected Defender destination addresses.
# Sources may be private lab addresses, so these rules use any -> $HOME_NET.
# Rules are alert-only. Site-specific WordPress/phpMyAdmin rules 2200001,
# 2200002 and 2200006, TLS lab SNI 2200101, and SSH banner 2200201 are retired.

# Web reconnaissance and access attempts independent of the web application.
alert http any any -> $HOME_NET any (msg:"scanner_user_agent"; flow:established,to_server; http.user_agent; pcre:"/(?:sqlmap|nikto|nuclei)/i"; classtype:attempted-recon; metadata:severity medium, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200003; rev:4;)
alert http any any -> $HOME_NET any (msg:"env_file_access"; flow:established,to_server; http.uri; content:"/.env"; startswith; nocase; classtype:web-application-attack; metadata:severity high, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200004; rev:3;)
alert http any any -> $HOME_NET any (msg:"git_config_access"; flow:established,to_server; http.uri; content:"/.git/config"; startswith; nocase; classtype:web-application-attack; metadata:severity high, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200005; rev:3;)
alert http any any -> $HOME_NET any (msg:"path_traversal"; flow:established,to_server; http.uri.raw; content:"../"; content:"etc/passwd"; distance:0; within:64; classtype:web-application-attack; metadata:severity high, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200007; rev:2;)
alert http any any -> $HOME_NET any (msg:"password_file_access"; flow:established,to_server; http.uri; content:"/.htpasswd"; startswith; nocase; classtype:web-application-attack; metadata:severity high, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200008; rev:2;)
alert http any any -> $HOME_NET any (msg:"svn_metadata_access"; flow:established,to_server; http.uri; content:"/.svn/entries"; startswith; nocase; classtype:attempted-recon; metadata:severity medium, project mimic, protocol http; threshold:type limit, track by_src, count 1, seconds 60; sid:2200009; rev:2;)

# HTTPS transport policy: tls.version is the negotiated version, not a URI or
# the legacy record version offered in ClientHello. Nginx should reject both.
alert tls any any -> $HOME_NET 443 (msg:"tls_1_0_negotiated"; flow:established,to_server; tls.version:1.0; classtype:misc-activity; metadata:severity low, project mimic, protocol https; threshold:type limit, track by_src, count 1, seconds 300; sid:2200102; rev:1;)
alert tls any any -> $HOME_NET 443 (msg:"tls_1_1_negotiated"; flow:established,to_server; tls.version:1.1; classtype:misc-activity; metadata:severity low, project mimic, protocol https; threshold:type limit, track by_src, count 1, seconds 300; sid:2200103; rev:1;)

# Repeated SYNs are indicators, not proof of distinct connections or ports.
alert tcp any any -> $HOME_NET 22 (msg:"ssh_connection_burst"; flow:to_server,stateless; flags:S; classtype:attempted-admin; metadata:severity high, project mimic, protocol ssh; threshold:type both, track by_src, count 5, seconds 30; sid:2200202; rev:4;)
alert tcp any any -> $HOME_NET 23 (msg:"telnet_connection_burst"; flow:to_server,stateless; flags:S; classtype:attempted-admin; metadata:severity high, project mimic, protocol telnet; threshold:type both, track by_src, count 5, seconds 30; sid:2200203; rev:4;)
alert tcp any any -> $HOME_NET any (msg:"syn_burst"; flow:to_server,stateless; flags:S; classtype:network-scan; metadata:severity medium, project mimic, protocol scan, behavior raise_next_connection_risk; threshold:type both, track by_src, count 10, seconds 5; sid:2200301; rev:4;)
